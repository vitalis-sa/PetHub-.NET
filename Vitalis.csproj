<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- Microsoft.Extensions.Diagnostics.HealthChecks é referenciado explicitamente (requisito da sprint),
             ainda que já venha transitivamente pelo framework compartilhado. -->
        <NoWarn>$(NoWarn);NU1510</NoWarn>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
      <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
      <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
      <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
      <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
      <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26200" />
      <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Views\Dono\Create.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Dono\Delete.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Dono\Details.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Dono\Edit.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Dono\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Consulta\Create.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Consulta\Delete.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Consulta\Details.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Consulta\Edit.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Consulta\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Pet\Create.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Pet\Delete.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Pet\Details.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Pet\Edit.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Pet\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Sintoma\Create.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Sintoma\Delete.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Sintoma\Details.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Sintoma\Edit.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Sintoma\Index.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Lembrete\Create.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Lembrete\Delete.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Lembrete\Details.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Lembrete\Edit.cshtml" />
      <_ContentIncludedByDefault Remove="Views\Lembrete\Index.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Migrations\" />
    </ItemGroup>

    <!-- Os projetos de teste vivem sob tests/ e não fazem parte da compilação da API. -->
    <ItemGroup>
      <Compile Remove="tests/**" />
      <Content Remove="tests/**" />
      <EmbeddedResource Remove="tests/**" />
      <None Remove="tests/**" />
      <Compile Remove="logs/**" />
      <Content Remove="logs/**" />
    </ItemGroup>

</Project>
